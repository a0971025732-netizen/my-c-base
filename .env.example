# Claude (profile building, judging, drafting). Without it: heuristics + human scoring.
ANTHROPIC_API_KEY=

# Reddit — requires an APPROVED Data API app under Reddit's Responsible Builder Policy.
# Discovery needs the first three; API publishing (`finch publish --mode api`) also needs username/password.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=finch-harness/0.1 by u/<your_finch_account>
REDDIT_USERNAME=
REDDIT_PASSWORD=

# X — pay-per-use bearer token for search + metrics only. Replies are always posted by a human.
X_BEARER_TOKEN=

# Optional
# FINCH_DATA_DIR=./data
# FINCH_REDDIT_MIN_INTERVAL_S=600
